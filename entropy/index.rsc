1:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to content"}],["$","header",null,{"className":"masthead wrap","children":[["$","a",null,{"href":"https://thebonhomme.com/","className":"brand","children":["Le Bonhomme",["$","br",null,{}],["$","strong",null,{"children":"Pharma"}]]}],["$","span",null,{"className":"publication","children":["RESEARCH NOTES",["$","br",null,{}],"01 — ENTROPY"]}],["$","nav",null,{"className":"language-nav","aria-label":"Language","children":[["$","a","en",{"href":"/entropy/","hrefLang":"en","lang":"en","aria-current":"page","children":"EN"}],["$","a","fr",{"href":"/entropy/fr/","hrefLang":"fr","lang":"fr","aria-current":"$undefined","children":"FR"}],["$","a","es",{"href":"/entropy/es/","hrefLang":"es","lang":"es","aria-current":"$undefined","children":"ES"}]]}],["$","nav",null,{"aria-label":"Page","children":[["$","a",null,{"href":"#kernel","children":"Kernel"}],["$","a",null,{"href":"#laboratory","children":"Explore"}],["$","a",null,{"href":"#sources","children":"Sources ↗"}]]}]]}],["$","main",null,{"id":"main","children":[["$","section",null,{"className":"hero wrap","aria-labelledby":"title","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"tiny-cross","children":"+"}]," STATISTICAL MECHANICS × INFORMATION THEORY"]}],["$","h1",null,{"id":"title","children":["One kernel.",["$","br",null,{}],["$","span",null,{"children":"Different worlds."}]]}],["$","div",null,{"className":"hero-bottom","children":[["$","p",null,{"children":["A molecule explores poses. A language model assigns probabilities to tokens. ",["$","strong",null,{"children":"The distribution is the link."}]]}],["$","a",null,{"className":"text-link","href":"#laboratory","children":["Explore the kernel ",["$","span",null,{"children":"↓"}]]}]]}],["$","div",null,{"className":"hero-strip","children":[["$","a",null,{"href":"https://github.com/LeBonhommePharma/FlexAIDdS","children":"FLEXAID∆S ↗"}],["$","span",null,{"aria-label":"Shannon entropy: minus the sum of probability times log base two of probability","children":"←   H = −Σ pᵢ log₂ pᵢ   →"}],["$","a",null,{"href":"https://github.com/LeBonhommePharma/Shannon","children":"SHANNON ↗"}]]}]]}],["$","section",null,{"id":"kernel","className":"kernel wrap","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-index","children":"01 / THE COMMON LANGUAGE"}],["$","h2",null,{"children":["Count the possibilities.",["$","br",null,{}],"Keep their weights."]}]]}],["$","div",null,{"className":"kernel-grid","children":[["$","div",null,{"children":[["$","p",null,{"children":"Entropy measures how probability is spread over a declared set of alternatives. A single dominant state has low entropy. Many equally weighted states have high entropy."}],["$","p",null,{"children":"The same normalization and entropy calculation works for molecular states and token choices. The state space, the origin of the weights, and their physical meaning remain domain-specific."}],["$","p",null,{"className":"kernel-note","children":"First define the alternatives. Then define their measure. Only then interpret their entropy."}],["$","a",null,{"className":"source-inline","href":"https://github.com/LeBonhommePharma/Shannon/blob/5c09cead058d8c84dd40cbaa5706f2457f35ebb2/src/shannon/entropy_algorithm.hpp#L67-L115","children":"Read the shared implementation ↗"}]]}],["$","div",null,{"className":"formula-sheet","children":[["$","div",null,{"children":[["$","span",null,{"children":"01 / LOG-WEIGHTS"}],["$","p",null,{"children":"aᵢ"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"02 / NORMALIZE"}],["$","p",null,{"children":["L = ln ∑ e",["$","sup",null,{"children":"aᵢ"}],["$","br",null,{}],"pᵢ = e",["$","sup",null,{"children":"aᵢ − L"}]]}]]}],["$","div",null,{"className":"formula-final","children":[["$","span",null,{"children":"03 / MEASURE"}],["$","p",null,{"children":["H",["$","sub",null,{"children":"nats"}]," = L − ∑ pᵢaᵢ"]}]]}],["$","p",null,{"className":"caption","children":["H",["$","sub",null,{"children":"bits"}]," = H",["$","sub",null,{"children":"nats"}]," / ln 2",["$","br",null,{}],"pᵢ ≥ 0 · ∑ pᵢ = 1 · 0 log 0 = 0"]}]]}]]}],["$","div",null,{"className":"stability-note","children":[["$","span",null,{"children":"NUMERICAL RIGOR"}],["$","p",null,{"children":"Subtract m = max aᵢ before exponentiating. Compute L = m + ln ∑ exp(aᵢ − m). This stabilizes the calculation without changing the distribution."}]]}]]}],["$","section",null,{"id":"laboratory","className":"lab-section","children":"$Ld"}],"$Le","$Lf","$L10"]}],"$L11"]
