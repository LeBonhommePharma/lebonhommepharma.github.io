e:["$","section",null,{"id":"worlds","className":"worlds wrap","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-index","children":"03 / TWO INSTANTIATIONS"}],["$","h2",null,{"children":["The algebra travels.",["$","br",null,{}],"The interpretation must earn it."]}]]}],["$","div",null,{"className":"world-grid","children":[["$","article",null,{"children":[["$","span",null,{"className":"world-label","children":"MOLECULAR SEARCH"}],["$","h3",null,{"children":"FlexAID∆S"}],["$","p",null,{"className":"world-deck","children":"From a collection of poses to a weighted ensemble."}],["$","div",null,{"className":"world-equation","children":["aᵢ = −βEᵢ",["$","br",null,{}],["$","span",null,{"children":"β = 1 / (κT)"}]]}],["$","p",null,{"children":"For individually represented, unit-multiplicity states with calibrated energies, Z sums their Boltzmann weights. The canonical free-energy identity balances the mean energy against entropy:"}],["$","p",null,{"className":"world-equation","children":["F = −κT ln Z = ⟨E⟩ − TS",["$","br",null,{}],["$","span",null,{"children":["S = κH",["$","sub",null,{"children":"nats"}]]}]]}],["$","p",null,{"children":["Use κ = k",["$","sub",null,{"children":"B"}]," for per-particle energies, or R for molar energies. A populated basin can matter even when it does not contain the single lowest-energy pose."]}],["$","div",null,{"className":"boundary","children":[["$","strong",null,{"children":"What has to be established"}],["$","p",null,{"children":"Calibrated energies, a defined state-space measure, and adequate sampling. A docking contact score passed through softmax is a score-space proxy. A binding ΔG additionally requires a matched association cycle; it is not the free energy of an arbitrary pose list."}]]}],["$","a",null,{"className":"source-inline","href":"https://github.com/LeBonhommePharma/FlexAIDdS/blob/51f12af4f99b1e0956553acec617bab9f18e91d0/LIB/statmech.h#L31-L97","children":"Physical provenance requirements ↗"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"world-label","children":"TOKEN DISTRIBUTIONS"}],["$","h3",null,{"children":"Shannon"}],["$","p",null,{"className":"world-deck","children":"From next-token alternatives to an uncertainty trace."}],["$","div",null,{"className":"world-equation","children":["aᵢ = zᵢ / τ",["$","br",null,{}],["$","span",null,{"children":"pᵢ = softmax(z / τ)ᵢ"}]]}],["$","p",null,{"children":"At a fixed context, a model’s logits zᵢ define relative weights over token choices. Their entropy describes concentration in that predictive distribution."}],["$","p",null,{"className":"world-equation","children":["H",["$","sub",null,{"children":"bits"}]," = −∑ pᵢ log₂ pᵢ",["$","br",null,{}],["$","span",null,{"children":["N",["$","sub",null,{"children":"eff"}]," = 2",["$","sup",null,{"children":["H",["$","sub",null,{"children":"bits"}]]}]]}]]}],["$","p",null,{"children":"The effective state count is the number of equally likely alternatives with the same entropy. The analogy zᵢ = −Eᵢ is mathematical; a token logit does not acquire thermodynamic energy units."}],["$","div",null,{"className":"boundary","children":[["$","strong",null,{"children":"What has to be established"}],["$","p",null,{"children":"The probability support, normalization, and treatment of omitted tokens. A top-k feed does not establish full-vocabulary entropy. A sharp prediction can still be confidently wrong."}]]}],["$","a",null,{"className":"source-inline","href":"https://github.com/LeBonhommePharma/Shannon/blob/5c09cead058d8c84dd40cbaa5706f2457f35ebb2/python/shannon/integrations/logprob_feed.py#L20-L64","children":"Inspect the probability feed ↗"}]]}]]}],["$","details",null,{"className":"technical-note","children":[["$","summary",null,{"children":["Grouped microstates: why multiplicity matters ",["$","span",null,{"children":"+"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"If record i represents nᵢ microstates of equal energy, use aᵢ = ln nᵢ − βEᵢ. Entropy across records and entropy across microstates are then different:"}],["$","p",null,{"className":"equation","children":["S / κ = H","$L13"," + ⟨ln n⟩"]}],"$L14","$L15"]}]]}]]}]
f:["$","section",null,{"id":"collapse","className":"collapse-section","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-index","children":"04 / SHANNON ENERGY COLLAPSE"}],["$","h2",null,{"children":["A distribution narrows.",["$","br",null,{}],"What did we actually learn?"]}]]}],["$","p",null,{"className":"collapse-intro","children":"For optimization, concentration is a useful signal to watch. Its value depends on what is concentrating, how it was sampled, and whether the result survives an independent check."}],["$","div",null,{"className":"collapse-grid","children":[["$","article",null,{"children":[["$","span",null,{"className":"section-index","children":"FLEXAID∆S / SEARCH POPULATION"}],["$","h3",null,{"children":"Energy-histogram entropy"}],["$","p",null,{"children":["Here p",["$","sub",null,{"children":"b"}]," = count",["$","sub",null,{"children":"b"}]," / N. Entropy describes occupancy across score bins in the current search population. It is distinct from the Boltzmann-weight entropy of a pose ensemble."]}],["$","p",null,{"children":"The source defines soft and hard levels at 2 and 1 bit. It also records a historical 256-bin origin versus current 20-bin callers. These are implementation thresholds, dependent on binning and support."}],["$","a",null,{"className":"source-inline","href":"https://github.com/LeBonhommePharma/FlexAIDdS/blob/51f12af4f99b1e0956553acec617bab9f18e91d0/LIB/ShannonThermoStack/ShannonThermoStack.h#L31-L69","children":"Thresholds and their limits ↗"}]]}],["$","article",null,{"children":[["$","span",null,{"className":"section-index","children":"SHANNON / TOKEN STREAM"}],["$","h3",null,{"children":"A drop against a rolling mean"}],["$","p",null,{"children":["The current C++ default compares H",["$","sub",null,{"children":"t"}]," against an eight-sample rolling mean that includes the current sample. A full window and δ",["$","sub",null,{"children":"t"}]," < −3.2 bits trigger the detector."]}],["$","p",null,{"className":"collapse-equation","children":["δ",["$","sub",null,{"children":"t"}]," = H",["$","sub",null,{"children":"t"}]," − H̄",["$","sub",null,{"children":"window"}]]}],["$","p",null,{"children":"The threshold is in bits. A z-score is computed separately. This is a change detector, not the same test as the docking histogram thresholds."}],["$","a",null,{"className":"source-inline","href":"https://github.com/LeBonhommePharma/Shannon/blob/5c09cead058d8c84dd40cbaa5706f2457f35ebb2/src/shannon/collapse_detector.cpp#L245-L265","children":"Read the actual decision rule ↗"}]]}]]}],["$","div",null,{"className":"pull-quote","children":[["$","span",null,{"aria-hidden":"true","children":"H ↓"}],["$","blockquote",null,{"children":["Concentration is observable.",["$","br",null,{}],["$","em",null,{"children":"Correctness needs evidence."}]]}]]}],["$","p",null,{"className":"claim-limit","children":"Relabel the states and entropy stays the same—even if the dominant answer becomes wrong. Low entropy alone cannot establish a correct docking pose, truthful reasoning, deception, or evaluation awareness. Those claims need independent ground truth."}]]}]}]
